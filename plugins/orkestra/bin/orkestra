#!/usr/bin/env python3
"""orkestra CLI launcher (added to PATH by Claude Code via the plugin's bin/ directory)."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))

if sys.version_info < (3, 9):
    sys.stderr.write("orkestra needs Python >= 3.9 (found %s). Install a newer python3 (e.g. brew install python).\n"
                     % sys.version.split()[0])
    sys.exit(2)

from orkestra_core.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
